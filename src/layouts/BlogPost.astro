---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
} = Astro.props;
const tocHeadings = headings.filter((h) => h.depth <= 3);
const allPosts = await getCollection('blog');
const currentId = decodeURIComponent(Astro.url.pathname)
	.replace(/^\/blog\//, '')
	.replace(/\/$/, '');
const currentPost = allPosts.find((post) => post.id === currentId);
const currentDirectoryParts = currentPost?.id.split('/').slice(0, -1) || [];
const currentDirectory = currentDirectoryParts.join('/');
const directoryPosts = allPosts
	.filter((post) => post.id.split('/').slice(0, -1).join('/') === currentDirectory)
	.sort(
		(a, b) =>
			Number(b.data.pinned) - Number(a.data.pinned) ||
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
			a.data.title.localeCompare(b.data.title),
	);
const navigationLabel = (value: string) =>
	value
		.split('-')
		.map((part, index) => {
			if (['cs', 'ai', 'ml'].includes(part)) return part.toUpperCase();
			if (index > 0 && ['to', 'of', 'and'].includes(part)) return part;
			return part[0].toUpperCase() + part.slice(1);
		})
		.join(' ');

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: 'Yanxiang Zhang',
		url: 'https://yanxiangzhang.com',
	},
	...(heroImage && { image: new URL(heroImage.src, Astro.site).toString() }),
});
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={jsonLd} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.article-shell {
				display: grid;
				grid-template-columns: 220px minmax(0, 1fr) 260px;
				gap: clamp(1.5rem, 2.5vw, 3rem);
				align-items: start;
				width: min(100% - 4rem, 1680px);
				margin: 0 auto;
				padding: 1.5rem 0 3rem;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 4px;
			}
			.prose {
				width: 100%;
				min-width: 0;
				padding: 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1em 0 0;
				text-align: left;
				line-height: 1.3;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
				font-family: var(--font-serif);
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 0.5rem;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.875rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
			/* Blog navigation */
			.blog-nav {
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				scrollbar-width: thin;
				scrollbar-color: rgba(var(--gray), 0.22) transparent;
				padding: 0.9rem 1rem 0.9rem 0;
				border-right: 1px solid rgb(var(--gray-light));
			}
			.blog-nav-title {
				margin: 0 0 0.65rem;
				font-weight: 700;
				font-size: 0.86rem;
				color: rgb(var(--black));
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.blog-nav ul {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.blog-nav li {
				margin: 0;
				font-size: 0.86rem;
				line-height: 1.4;
			}
			.blog-nav a {
				display: block;
				padding: 0.38rem 0.5rem;
				border-radius: 3px;
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.15s ease, background-color 0.15s ease;
			}
			.blog-nav a:hover,
			.blog-nav a.active {
				color: var(--accent);
				background: rgba(var(--gray-light), 0.45);
			}
			.blog-nav .directory-link {
				margin-bottom: 0.55rem;
				padding-bottom: 0.55rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			.blog-nav .file-link {
				overflow: hidden;
				text-overflow: ellipsis;
			}
			/* TOC */
			.toc {
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				scrollbar-width: thin;
				scrollbar-color: rgba(var(--gray), 0.22) transparent;
				padding: 0.9rem 0 0.9rem 1rem;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.blog-nav::-webkit-scrollbar,
			.toc::-webkit-scrollbar {
				width: 5px;
			}
			.blog-nav::-webkit-scrollbar-track,
			.toc::-webkit-scrollbar-track {
				background: transparent;
			}
			.blog-nav::-webkit-scrollbar-thumb,
			.toc::-webkit-scrollbar-thumb {
				border-radius: 999px;
				background: rgba(var(--gray), 0.18);
			}
			.blog-nav:hover::-webkit-scrollbar-thumb,
			.toc:hover::-webkit-scrollbar-thumb {
				background: rgba(var(--gray), 0.32);
			}
			.toc-title {
				margin: 0 0 0.65rem;
				font-weight: 700;
				font-size: 0.86rem;
				color: rgb(var(--black));
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.toc ol {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc li {
				margin: 0;
				font-size: 0.84rem;
				line-height: 1.4;
			}
			.toc a {
				display: block;
				padding: 0.34rem 0.5rem;
				border-radius: 3px;
				text-decoration: none;
				color: rgb(var(--gray));
				transition: color 0.15s ease, background-color 0.15s ease;
			}
			.toc a:hover,
			.toc a.active {
				color: var(--accent);
				background: rgba(var(--gray-light), 0.45);
			}
			.toc .depth-3 {
				padding-left: 0.8rem;
			}
			.toc .depth-1 a {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 980px) {
				.article-shell {
					grid-template-columns: 210px minmax(0, 1fr);
					justify-content: center;
					gap: 1.5rem;
					width: calc(100% - 3rem);
				}
				.toc {
					position: static;
					grid-column: 2;
					grid-row: 1;
					max-height: 18rem;
					margin-bottom: 1rem;
					padding: 0.85rem 1rem;
					border: 1px solid rgb(var(--gray-light));
					border-radius: 6px;
					background: rgba(var(--gray-light), 0.18);
				}
				.prose {
					grid-column: 2;
					grid-row: 2;
				}
				.blog-nav {
					grid-column: 1;
					grid-row: 1 / span 2;
				}
			}
			@media (max-width: 720px) {
				.article-shell {
					grid-template-columns: minmax(0, 1fr);
					width: calc(100% - 2.5rem);
					padding-top: 0.5rem;
				}
				.blog-nav {
					position: static;
					grid-column: 1;
					grid-row: 1;
					max-height: 14rem;
					padding: 0.85rem 1rem;
					border: 1px solid rgb(var(--gray-light));
					border-radius: 6px;
					background: rgba(var(--gray-light), 0.18);
				}
				.toc {
					grid-column: 1;
					grid-row: 2;
				}
				.prose {
					grid-column: 1;
					grid-row: 3;
				}
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="article-shell">
					<nav class="blog-nav" aria-label="Blog 导航">
						<p class="blog-nav-title">当前目录</p>
						<a class="directory-link" href={`/blog/${currentDirectory}/`}>
							← {navigationLabel(currentDirectoryParts.at(-1) || 'Blog')}
						</a>
						<ul>
							{
								directoryPosts.map((post) => (
									<li>
										<a
											class:list={['file-link', { active: post.id === currentId }]}
											href={`/blog/${post.id}/`}
											title={post.data.title}
										>
											{post.data.title}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<div class="prose">
						<a class="back-link" href="javascript:history.back()">← Back</a>
						<div class="title">
							<h1>{title}</h1>
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											&middot; Updated <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							<hr />
						</div>
						<slot />
					</div>
					{
						tocHeadings.length > 2 && (
							<aside class="toc" aria-label="文章大纲">
								<p class="toc-title">文章大纲</p>
							<ol>
								{tocHeadings.map((h) => (
									<li class={`depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const mermaidBlocks = Array.from(
				document.querySelectorAll<HTMLPreElement>('pre[data-language="mermaid"]'),
			);

			if (mermaidBlocks.length) {
				const renderMermaid = async () => {
					const { default: mermaid } = await import('mermaid');
					const darkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;

					mermaid.initialize({
						startOnLoad: false,
						securityLevel: 'strict',
						theme: darkMode ? 'dark' : 'neutral',
						fontFamily: '"Maple Mono NL NF CN", "Maple Mono", monospace',
						htmlLabels: true,
						flowchart: {
							useMaxWidth: false,
							wrappingWidth: 480,
						},
					});

					for (const [index, block] of mermaidBlocks.entries()) {
						const source = block.textContent?.trim();
						if (!source) continue;

						try {
							const { svg, bindFunctions } = await mermaid.render(
								`mermaid-diagram-${index}`,
								source,
							);
							const figure = document.createElement('figure');
							figure.className = 'mermaid-diagram';
							figure.innerHTML = svg;
							const renderedSvg = figure.querySelector('svg');
							if (renderedSvg) {
								const intrinsicWidth = renderedSvg.viewBox.baseVal.width;
								renderedSvg.style.maxWidth = 'none';
								if (intrinsicWidth > 0) renderedSvg.style.width = `${intrinsicWidth}px`;
								renderedSvg.style.height = 'auto';
							}
							block.replaceWith(figure);
							bindFunctions?.(figure);
						} catch (error) {
							block.classList.add('mermaid-error-source');
							const message = document.createElement('p');
							message.className = 'mermaid-error';
							message.textContent = 'Mermaid 图表语法错误，已保留源代码。';
							block.insertAdjacentElement('beforebegin', message);
							console.error('Mermaid render failed:', error);
						}
					}
				};

				renderMermaid().catch((error) => {
					console.error('Unable to load Mermaid:', error);
				});
			}

			const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
			const headingsById = links
				.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
				.filter((heading): heading is HTMLElement => Boolean(heading));

			if (links.length && headingsById.length) {
				const updateActiveLink = () => {
					const offset = 120;
					let activeId = headingsById[0].id;

					for (const heading of headingsById) {
						if (heading.getBoundingClientRect().top <= offset) activeId = heading.id;
						else break;
					}

					for (const link of links) {
						link.classList.toggle('active', decodeURIComponent(link.hash.slice(1)) === activeId);
					}
				};

				updateActiveLink();
				document.addEventListener('scroll', updateActiveLink, { passive: true });
			}
		</script>
	</body>
</html>
