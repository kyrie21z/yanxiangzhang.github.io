---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
} = Astro.props;
const tocHeadings = headings.filter((h) => h.depth <= 3);

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	author: {
		'@type': 'Person',
		name: 'Yanxiang Zhang',
		url: 'https://yanxiangzhang.com',
	},
	...(heroImage && { image: new URL(heroImage.src, Astro.site).toString() }),
});
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<script type="application/ld+json" set:html={jsonLd} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.article-shell {
				display: grid;
				grid-template-columns: minmax(0, 820px) 250px;
				gap: 3rem;
				align-items: start;
				width: min(100% - 2rem, 1120px);
				margin: 0 auto;
				padding: 1rem 0 3rem;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 4px;
			}
			.prose {
				width: 100%;
				min-width: 0;
				padding: 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1.5em;
				padding: 1em 0 0;
				text-align: left;
				line-height: 1.3;
			}
			.title h1 {
				margin: 0 0 0.4em 0;
				font-family: var(--font-serif);
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 0.5rem;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.875rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
			/* TOC */
			.toc {
				position: sticky;
				top: 1.5rem;
				max-height: calc(100vh - 3rem);
				overflow-y: auto;
				padding: 0.9rem 0 0.9rem 1rem;
				border-left: 1px solid rgb(var(--gray-light));
			}
			.toc-title {
				margin: 0 0 0.65rem;
				font-weight: 700;
				font-size: 0.78rem;
				color: rgb(var(--black));
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.toc ol {
				margin: 0;
				padding: 0;
				list-style: none;
			}
			.toc li {
				margin: 0;
				font-size: 0.78rem;
				line-height: 1.4;
			}
			.toc a {
				display: block;
				padding: 0.28rem 0.45rem;
				border-radius: 3px;
				text-decoration: none;
				color: rgb(var(--gray));
				transition: color 0.15s ease, background-color 0.15s ease;
			}
			.toc a:hover,
			.toc a.active {
				color: var(--accent);
				background: rgba(var(--gray-light), 0.45);
			}
			.toc .depth-3 {
				padding-left: 0.8rem;
			}
			.toc .depth-1 a {
				font-weight: 600;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 1080px) {
				.article-shell {
					grid-template-columns: minmax(0, 820px);
					justify-content: center;
					gap: 1rem;
				}
				.toc {
					position: static;
					grid-row: 1;
					max-height: 18rem;
					margin-bottom: 1rem;
					padding: 0.85rem 1rem;
					border: 1px solid rgb(var(--gray-light));
					border-radius: 6px;
					background: rgba(var(--gray-light), 0.18);
				}
				.prose {
					grid-row: 2;
				}
			}
			@media (max-width: 720px) {
				.article-shell {
					width: calc(100% - 2rem);
					padding-top: 0.5rem;
				}
				.title h1 {
					font-size: 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt={title} />}
				</div>
				<div class="article-shell">
					<div class="prose">
						<a class="back-link" href="javascript:history.back()">← Back</a>
						<div class="title">
							<h1>{title}</h1>
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											&middot; Updated <FormattedDate date={updatedDate} />
										</span>
									)
								}
							</div>
							<hr />
						</div>
						<slot />
					</div>
					{
						tocHeadings.length > 2 && (
							<aside class="toc" aria-label="文章大纲">
								<p class="toc-title">文章大纲</p>
							<ol>
								{tocHeadings.map((h) => (
									<li class={`depth-${h.depth}`}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ol>
							</aside>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
			const headingsById = links
				.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
				.filter((heading): heading is HTMLElement => Boolean(heading));

			if (links.length && headingsById.length) {
				const updateActiveLink = () => {
					const offset = 120;
					let activeId = headingsById[0].id;

					for (const heading of headingsById) {
						if (heading.getBoundingClientRect().top <= offset) activeId = heading.id;
						else break;
					}

					for (const link of links) {
						link.classList.toggle('active', decodeURIComponent(link.hash.slice(1)) === activeId);
					}
				};

				updateActiveLink();
				document.addEventListener('scroll', updateActiveLink, { passive: true });
			}
		</script>
	</body>
</html>
