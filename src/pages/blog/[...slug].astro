---
import { render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { loadNoteCatalog, type BlogEntry } from '../../lib/blog-collection';
import type { DirectoryContext } from '../../lib/note-catalog.mjs';

export async function getStaticPaths() {
	const catalog = await loadNoteCatalog();
	return catalog.allNotes().map((note) => ({
		params: { slug: note.id },
		props: {
			post: note.entry,
			directoryContext: catalog.directoryContext(note.id),
		},
	}));
}

interface Props {
	post: BlogEntry;
	directoryContext: DirectoryContext<BlogEntry>;
}

const { post, directoryContext } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
---

<BlogPost
	{...post.data}
	headings={headings}
	hasMath={Boolean(remarkPluginFrontmatter.hasMath)}
	directoryContext={directoryContext}
>
	<Content />
</BlogPost>
