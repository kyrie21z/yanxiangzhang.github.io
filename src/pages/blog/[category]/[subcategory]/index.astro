---
import NoteListing from '../../../../components/NoteListing.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../../consts';
import PageShell from '../../../../layouts/PageShell.astro';
import { loadNoteCatalog } from '../../../../lib/blog-collection';

export async function getStaticPaths() {
	const catalog = await loadNoteCatalog();
	return catalog.subcategoryPages().map((page) => ({
		params: { category: page.category, subcategory: page.subcategory },
		props: {
			categoryLabel: page.categoryLabel,
			categoryUrl: page.categoryUrl,
			subcategoryLabel: page.subcategoryLabel,
			disclosure: page.disclosure,
			posts: page.posts,
		},
	}));
}

const { categoryLabel, categoryUrl, subcategoryLabel, disclosure, posts } = Astro.props;
---

<PageShell title={`${subcategoryLabel} | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<a class="back-link" href={categoryUrl}>← Back to {categoryLabel}</a>
		<h1>{subcategoryLabel}</h1>
		{disclosure && <p class="page-description">{disclosure}</p>}
		<section>
			<NoteListing posts={posts} emptyMessage="No posts found" />
		</section>
	</main>
</PageShell>

<style>
	main {
		width: 720px;
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 0.5rem;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.85rem;
	}
	.back-link:hover {
		color: var(--accent);
	}
	h1 {
		margin-bottom: 0;
		color: rgb(var(--black));
		font-family: var(--font-serif);
		font-size: 1.75rem;
	}
	.page-description {
		margin: 0.35rem 0 1.5rem;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		font-style: italic;
	}
	h1:not(:has(+ .page-description)) {
		margin-bottom: 1.5rem;
	}
	@media (max-width: 720px) {
		main {
			padding: 1rem;
		}
	}
</style>
