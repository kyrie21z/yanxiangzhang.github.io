---
import NoteListing from '../../../components/NoteListing.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';
import PageShell from '../../../layouts/PageShell.astro';
import { loadNoteCatalog } from '../../../lib/blog-collection';

export async function getStaticPaths() {
	const catalog = await loadNoteCatalog();
	return catalog.categoryPages().map((page) => ({
		params: { category: page.slug },
		props: {
			categoryLabel: page.label,
			subCategories: page.subCategories,
			directPosts: page.directPosts,
		},
	}));
}

const { categoryLabel, subCategories, directPosts } = Astro.props;
---

<PageShell title={`${categoryLabel} | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<a class="back-link" href="/blog/">← Back to category list</a>
		<h1>{categoryLabel}</h1>
		<section>
			<NoteListing
				categories={subCategories}
				posts={directPosts}
				emptyMessage="No posts found in this category"
			/>
		</section>
	</main>
</PageShell>

<style>
	main {
		width: 720px;
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 0.5rem;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.85rem;
	}
	.back-link:hover {
		color: var(--accent);
	}
	h1 {
		margin-bottom: 1.5rem;
		color: rgb(var(--black));
		font-family: var(--font-serif);
		font-size: 1.75rem;
	}
	@media (max-width: 720px) {
		main {
			padding: 1rem;
		}
	}
</style>
