---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	
	// 获取所有分类
	const categories = new Set<string>();
	posts.forEach((post) => {
		const parts = post.id.split('/');
		if (parts.length > 1) {
			categories.add(parts[0]);
		}
	});
	
	return Array.from(categories).map((category) => ({
		params: { category },
	}));
}

const { category } = Astro.params;

const posts = await getCollection('blog');
const categoryPosts = posts
	.filter((post) => post.id.startsWith(`${category}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${category} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1rem;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.875rem;
			}
			.back-link:hover {
				color: rgb(var(--accent));
			}
			.post-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.post-item {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				transition: all 0.2s ease;
			}
			.post-item:hover {
				box-shadow: var(--box-shadow);
				border-color: rgb(var(--accent));
			}
			.post-link {
				text-decoration: none;
				display: block;
			}
			.post-title {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
			}
			.post-date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			.post-description {
				margin: 0.5rem 0 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.9rem;
				line-height: 1.5;
			}
			.post-item:hover .post-title {
				color: rgb(var(--accent));
			}
			h1 {
				margin-bottom: 1.5rem;
				color: rgb(var(--black));
			}
			.empty-state {
				text-align: center;
				color: rgb(var(--gray));
				padding: 3rem 0;
			}
			@media (max-width: 720px) {
				main {
					padding: 1rem;
				}
				.post-item {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/blog/">← Back to category list</a>
			<h1>{category}</h1>
			<section>
				{
					categoryPosts.length > 0 ? (
						<ul class="post-list">
							{categoryPosts.map((post) => (
								<li class="post-item">
									<a class="post-link" href={`/blog/${post.id}/`}>
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										{post.data.description && (
											<p class="post-description">{post.data.description}</p>
										)}
									</a>
								</li>
								))}
							</ul>
						) : (
							<p class="empty-state">No posts found in this category</p>
						)
					}
				</section>
			</main>
			<Footer />
		</body>
	</html>
