---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// 按一级目录分组，统计总文章数
const categories = new Map<string, number>();
posts.forEach((post) => {
	const top = post.id.split('/')[0];
	categories.set(top, (categories.get(top) || 0) + 1);
});
// 排序：按名称
const sortedCategories = Array.from(categories.entries()).sort((a, b) => a[0].localeCompare(b[0]));

// 构建搜索索引数据（展示完整分类路径）
const allPosts = posts
	.sort(
		(a, b) =>
			Number(b.data.pinned) - Number(a.data.pinned) ||
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	)
	.map((post) => {
		const parts = post.id.split('/');
		// 去掉最后的文件名，拼接成分类路径
		const catPath = parts.slice(0, -1).join(' / ');
		return {
			title: post.data.title,
			description: post.data.description || '',
			url: `/blog/${post.id}/`,
			date: post.data.pubDate.toISOString(),
			category: catPath,
			pinned: post.data.pinned,
		};
	});
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Category | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.category-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.category-item {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 0.85rem 0;
				transition: color 0.15s ease;
			}
			.category-item:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			.category-link {
				text-decoration: none;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.category-name {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.05rem;
				font-weight: 600;
				font-family: var(--font-serif);
			}
			.category-count {
				color: rgb(var(--gray));
				font-size: 0.8rem;
			}
			.category-item:hover .category-name {
				color: var(--accent);
			}
			h1 {
				margin-bottom: 1.5rem;
				color: rgb(var(--black));
				font-family: var(--font-serif);
				font-size: 1.75rem;
			}
			.back-link {
				display: inline-block;
				margin-bottom: 0.5rem;
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.85rem;
			}
			.back-link:hover {
				color: var(--accent);
			}
			/* Search */
			.search-box {
				position: relative;
				margin-bottom: 1.5rem;
			}
			.search-input {
				width: 100%;
				padding: 0.6rem 1rem 0.6rem 2.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 4px;
				font-size: 0.9rem;
				font-family: inherit;
				outline: none;
				transition: border-color 0.15s ease;
				background: transparent;
				color: rgb(var(--gray-dark));
				box-sizing: border-box;
			}
			.search-input::placeholder {
				color: rgb(var(--gray));
			}
			.search-input:focus {
				border-color: var(--accent);
			}
			.search-icon {
				position: absolute;
				left: 0.75rem;
				top: 50%;
				transform: translateY(-50%);
				color: rgb(var(--gray));
				pointer-events: none;
			}
			@media (max-width: 720px) {
				main {
					padding: 1rem;
				}
			}
		</style>
		<style is:global>
			.search-results {
				display: none;
				list-style: none;
				margin: 0;
				padding: 0;
				margin-bottom: 1.5rem;
			}
			.search-results.active {
				display: block;
			}
			.search-result-item {
				border-bottom: 1px solid rgb(var(--gray-light));
				padding: 0.75rem 0;
				transition: color 0.15s ease;
			}
			.search-result-item:first-child {
				border-top: 1px solid rgb(var(--gray-light));
			}
			.search-result-item.pinned-frame {
				margin: 0.9rem 0 0.75rem;
				padding: 0.85rem;
			}
			.search-result-item a {
				text-decoration: none;
				display: block;
				color: inherit;
			}
			.search-result-title {
				display: block;
				font-size: 1rem;
				font-weight: 600;
				color: rgb(var(--black));
				margin: 0;
			}
			.search-result-item:hover .search-result-title {
				color: var(--accent);
			}
			.search-result-meta {
				display: block;
				font-size: 0.78rem;
				color: rgb(var(--gray));
				margin-top: 0.15rem;
			}
			.search-result-desc {
				display: block;
				font-size: 0.85rem;
				color: rgb(var(--gray-dark));
				margin-top: 0.25rem;
				line-height: 1.4;
			}
			.search-no-result {
				text-align: center;
				color: rgb(var(--gray));
				padding: 1.5rem 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back-link" href="/">← Back to Home</a>
			<h1>Category List</h1>

			<!-- Search -->
			<div class="search-box">
				<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<input type="text" class="search-input" id="search-input" placeholder="Search posts..." autocomplete="off" />
			</div>
			<ul class="search-results" id="search-results"></ul>

			<section id="category-section">
				<ul class="category-list">
					{
						sortedCategories.map(([category, count]) => (
							<li class="category-item">
								<a class="category-link" href={`/blog/${category}/`}>
									<h2 class="category-name">{category}</h2>
									<span class="category-count">{count} posts</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			</main>
			<Footer />
		<script define:vars={{ allPosts }}>
			const posts = allPosts;
			const input = document.getElementById('search-input');
			const resultsList = document.getElementById('search-results');
			const categorySection = document.getElementById('category-section');

			input.addEventListener('input', () => {
				const query = input.value.trim().toLowerCase();
				if (!query) {
					resultsList.classList.remove('active');
					resultsList.innerHTML = '';
					categorySection.style.display = '';
					return;
				}
				categorySection.style.display = 'none';

				const matches = posts.filter((p) =>
					p.title.toLowerCase().includes(query) ||
					p.description.toLowerCase().includes(query) ||
					p.category.toLowerCase().includes(query)
				);

				if (matches.length === 0) {
					resultsList.innerHTML = '<li class="search-no-result">No matching posts found</li>';
				} else {
					resultsList.innerHTML = matches.map((p) => {
						const date = new Date(p.date).toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' });
						const desc = p.description ? '<span class="search-result-desc">' + p.description + '</span>' : '';
						const pinnedClass = p.pinned ? ' pinned-frame' : '';
						return '<li class="search-result-item' + pinnedClass + '"><a href="' + p.url + '"><span class="search-result-title">' + p.title + '</span><span class="search-result-meta">' + p.category + ' \u00b7 ' + date + '</span>' + desc + '</a></li>';
					}).join('');
				}
				resultsList.classList.add('active');
			});
		</script>
		</body>
	</html>
