---
import NoteListing from '../../components/NoteListing.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import PageShell from '../../layouts/PageShell.astro';
import { loadNoteCatalog } from '../../lib/blog-collection';

const catalog = await loadNoteCatalog();
const sortedCategories = catalog.topCategories();
const allPosts = catalog.searchIndex();
---

<PageShell title={`Category | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<a class="back-link" href="/">← Back to Home</a>
		<h1>All notes</h1>

		<div class="search-box">
			<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="11" cy="11" r="8"></circle>
				<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
			</svg>
			<label class="sr-only" for="search-input">Search posts</label>
			<input type="text" class="search-input" id="search-input" placeholder="Search posts..." autocomplete="off" />
		</div>
		<ul class="search-results" id="search-results"></ul>

		<section id="category-section">
			<NoteListing categories={sortedCategories} />
		</section>
	</main>

	<script is:inline define:vars={{ allPosts }}>
		const posts = allPosts;
		const input = document.getElementById('search-input');
		const resultsList = document.getElementById('search-results');
		const categorySection = document.getElementById('category-section');

		function renderResultItem(post) {
			const li = document.createElement('li');
			li.className = post.pinned ? 'search-result-item pinned-frame' : 'search-result-item';

			const link = document.createElement('a');
			link.href = post.url;

			const title = document.createElement('span');
			title.className = 'search-result-title';
			title.textContent = post.title;
			link.appendChild(title);

			const meta = document.createElement('span');
			meta.className = 'search-result-meta';
			meta.textContent = `${post.category} \u00b7 ${post.formattedDate}`;
			link.appendChild(meta);

			if (post.description) {
				const desc = document.createElement('span');
				desc.className = 'search-result-desc';
				desc.textContent = post.description;
				link.appendChild(desc);
			}

			li.appendChild(link);
			return li;
		}

		input?.addEventListener('input', () => {
			const query = input.value.trim().toLowerCase();
			resultsList.replaceChildren();

			if (!query) {
				resultsList.classList.remove('active');
				categorySection.style.display = '';
				return;
			}
			categorySection.style.display = 'none';

			const matches = posts.filter(
				(p) =>
					p.title.toLowerCase().includes(query) ||
					p.description.toLowerCase().includes(query) ||
					p.category.toLowerCase().includes(query),
			);

			if (matches.length === 0) {
				const empty = document.createElement('li');
				empty.className = 'search-no-result';
				empty.textContent = 'No matching posts found';
				resultsList.appendChild(empty);
			} else {
				const fragment = document.createDocumentFragment();
				for (const post of matches) fragment.appendChild(renderResultItem(post));
				resultsList.appendChild(fragment);
			}
			resultsList.classList.add('active');
		});
	</script>
</PageShell>

<style>
	main {
		width: 760px;
		max-width: 100%;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}
	h1 {
		margin-bottom: 1.5rem;
		color: rgb(var(--black));
		font-family: var(--font-serif);
		font-size: 2.25rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 0.5rem;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.85rem;
	}
	.back-link:hover {
		color: var(--accent);
	}
	.search-box {
		position: relative;
		margin-bottom: 1.5rem;
	}
	.search-input {
		width: 100%;
		padding: 0.6rem 1rem 0.6rem 2.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--radius-control);
		font-size: 0.9rem;
		font-family: inherit;
		outline: none;
		transition: border-color 0.15s ease;
		background: var(--surface);
		color: rgb(var(--gray-dark));
		box-sizing: border-box;
	}
	.search-input::placeholder {
		color: rgb(var(--gray));
	}
	.search-input:focus {
		border-color: var(--accent);
	}
	.search-icon {
		position: absolute;
		left: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		color: rgb(var(--gray));
		pointer-events: none;
	}
	@media (max-width: 720px) {
		main {
			padding: 1rem;
		}
	}
</style>
<style is:global>
	.search-results {
		display: none;
		list-style: none;
		margin: 0;
		padding: 0;
		margin-bottom: 1.5rem;
	}
	.search-results.active {
		display: block;
	}
	.search-result-item {
		border-bottom: 1px solid rgb(var(--gray-light));
		padding: 0.75rem 0;
		transition: color 0.15s ease;
	}
	.search-result-item:first-child {
		border-top: 1px solid rgb(var(--gray-light));
	}
	.search-result-item.pinned-frame {
		margin: 0.9rem 0 0.75rem;
		padding: 0.85rem;
	}
	.search-result-item a {
		text-decoration: none;
		display: block;
		color: inherit;
	}
	.search-result-title {
		display: block;
		font-size: 1rem;
		font-weight: 600;
		color: rgb(var(--black));
		margin: 0;
	}
	.search-result-item:hover .search-result-title {
		color: var(--accent);
	}
	.search-result-meta {
		display: block;
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin-top: 0.15rem;
	}
	.search-result-desc {
		display: block;
		font-size: 0.85rem;
		color: rgb(var(--gray-dark));
		margin-top: 0.25rem;
		line-height: 1.4;
	}
	.search-no-result {
		text-align: center;
		color: rgb(var(--gray));
		padding: 1.5rem 0;
	}
</style>
