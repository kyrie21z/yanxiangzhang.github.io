---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');

// 按文件夹分组
const categories = posts.reduce((acc, post) => {
	const parts = post.id.split('/');
	const category = parts.length > 1 ? parts[0] : '未分类';
	if (!acc[category]) {
		acc[category] = [];
	}
	acc[category].push(post);
	return acc;
}, {} as Record<string, typeof posts>);

// 按发布日期排序每个分类下的文章
Object.keys(categories).forEach((key) => {
	categories[key].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Category | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			.category-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.category-item {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				transition: all 0.2s ease;
			}
			.category-item:hover {
				box-shadow: var(--box-shadow);
				border-color: rgb(var(--accent));
			}
			.category-link {
				text-decoration: none;
				display: flex;
				justify-content: space-between;
				align-items: center;
			}
			.category-name {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
				font-weight: 600;
			}
			.category-count {
				color: rgb(var(--gray));
				font-size: 0.875rem;
			}
			.category-item:hover .category-name {
				color: rgb(var(--accent));
			}
			h1 {
				text-align: center;
				margin-bottom: 2rem;
				color: rgb(var(--black));
			}
			@media (max-width: 720px) {
				main {
					padding: 1rem;
				}
				.category-item {
					padding: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Category List</h1>
			<section>
				<ul class="category-list">
					{
						Object.entries(categories).map(([category, categoryPosts]) => (
							<li class="category-item">
								<a class="category-link" href={`/blog/${category}/`}>
									<h2 class="category-name">{category}</h2>
									<span class="category-count">{categoryPosts.length} posts</span>
								</a>
							</li>
						))
						}
					</ul>
				</section>
			</main>
			<Footer />
		</body>
	</html>
