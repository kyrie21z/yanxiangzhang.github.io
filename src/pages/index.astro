---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import monicaImage from '../assets/monica.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* 覆盖全局 main 样式 */
			body main.home-container {
				width: 100%;
				max-width: 1200px;
			}
			
			.home-container {
				display: grid;
				grid-template-columns: 300px 1fr;
				gap: 3rem;
				align-items: start;
				max-width: 1200px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			
			@media (max-width: 900px) {
				.home-container {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
			}
			
			/* 左侧名片卡片 */
			.profile-card {
				background: rgba(255, 255, 255, 0.6);
				border-radius: 16px;
				padding: 1.5rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
				text-align: center;
				position: sticky;
				top: 2rem;
			}
			
			.profile-image {
				width: 160px;
				height: 160px;
				border-radius: 50%;
				object-fit: cover;
				margin-bottom: 1rem;
				border: 4px solid rgba(255, 255, 255, 0.8);
				box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
			}
			
			.profile-name {
				font-size: 1.5rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0.5rem 0;
			}
			
			.profile-underline {
				width: 40px;
				height: 3px;
				background: var(--accent);
				margin: 0.5rem auto;
				border-radius: 2px;
			}
			
			.profile-bio {
				font-size: 0.95rem;
				color: rgb(var(--gray));
				margin: 0.75rem 0 1.25rem;
				line-height: 1.5;
			}
			
			.social-links {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
			}
			
			.social-link {
				width: 40px;
				height: 40px;
				border-radius: 10px;
				background: rgba(var(--gray-light), 0.8);
				display: flex;
				align-items: center;
				justify-content: center;
				color: rgb(var(--gray-dark));
				text-decoration: none;
				transition: all 0.2s ease;
			}
			
			.social-link:hover {
				background: var(--accent);
				color: white;
				transform: translateY(-2px);
			}
			
			/* 右侧内容区域 */
			.content-section {
				background: rgba(255, 255, 255, 0.6);
				border-radius: 16px;
				padding: 2rem;
				box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
			}
			
			.section-title {
				font-size: 1.75rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 1.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 2px solid rgba(var(--gray-light), 0.8);
			}
			
			.about-text {
				font-size: 1rem;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}
			
			.about-text p {
				margin-bottom: 1rem;
			}
			
			.highlight {
				color: var(--accent);
				font-weight: 600;
			}
			
			.research-list {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				margin-top: 1rem;
			}
			
			.research-tag {
				/* background: rgba(var(--gray-light), 0.3); */
				padding: 0.35rem 0.9rem;
				border-radius: 20px;
				font-size: 0.9rem;
				font-family: Georgia, "Times New Roman", Times, serif;
				/* font-family: "Times New Roman", Times, serif; */
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-container">
			<!-- 左侧名片 -->
			<aside class="profile-card">
				<Image src={monicaImage} alt="Yanxiang Zhang" class="profile-image" width={200} height={200} />
				<h1 class="profile-name">Yanxiang Zhang</h1>
				<div class="profile-underline"></div>
				<p class="profile-bio">保持饥饿, 保持谦卑<br/>Hungry & Humble</p>
				<div class="social-links">
					<a href="https://github.com/kyrie21z" class="social-link" target="_blank" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
				</div>
			</aside>
			
			<!-- 右侧自我介绍 -->
			<section class="content-section">
				<h2 class="section-title">👋 About Me</h2>
				<div class="about-text">
					<p>
						Hello! I'm <span class="highlight">Yanxiang Zhang</span>.
					</p>
					<p>
						This blog is where I record my learning notes and share technical insights. Here, you can find content about 
						<span class="highlight">Algorithms</span>, <span class="highlight">Paper Sharing</span>, and 
						<span class="highlight">Paper Reproduction</span>.
					</p>
							
					<h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.2rem;">Research Interests</h3>
					<div class="research-list">
						<span class="research-tag">Computer Vision</span>
						<span class="research-tag">Multi-Agent Systems</span>
						<span class="research-tag">Embodied AI</span>
					</div>
							
					<h3 style="margin-top: 1.5rem; margin-bottom: 0.75rem; font-size: 1.2rem;">📝 Latest Posts</h3>
					<p>
						Welcome to browse my <a href="/blog">blog posts</a>, currently focusing on algorithm analysis and design notes.
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
