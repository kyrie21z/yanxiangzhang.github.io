---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import monicaImage from '../assets/monica.png';

const examplePosts = new Set(['paper-sharing/example-paper-sharing', 'personal-insights/example-personal-insights']);
const latestPosts = (await getCollection('blog'))
	.filter((post) => !post.id.startsWith('cs-major-courses/') && !examplePosts.has(post.id))
	.sort((a, b) => Number(b.data.pinned) - Number(a.data.pinned) || b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const featuredPost = latestPosts.find((post) => post.id.startsWith('research-notes/')) || latestPosts[0];
const remainingPosts = latestPosts.filter((post) => post.id !== featuredPost?.id);
const categoryLabel = (id: string) => id.split('/')[0].split('-').map((word) => word[0].toUpperCase() + word.slice(1)).join(' ');
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-container">
			<section class="hero" aria-labelledby="profile-name">
				<div>
					<p class="eyebrow">Research &amp; Notes</p>
					<h1 id="profile-name">Yanxiang Zhang<span class="accent-dot">.</span></h1>
					<p class="hero-description">Research notes, paper readings, and technical reflections.</p>
					<ul class="research-interests" aria-label="Research interests">
						<li>Computer Vision</li>
						<li>Scene Text Recognition</li>
						<li>Embodied AI</li>
					</ul>
					<div class="hero-links">
						<a class="button" href="/blog/research-notes/">Read research notes <span aria-hidden="true">↗</span></a>
						<a class="text-link" href="https://github.com/kyrie21z" target="_blank">GitHub <span aria-hidden="true">↗</span></a>
					</div>
				</div>
				<div class="portrait">
					<Image src={monicaImage} alt="Yanxiang Zhang" width={160} height={160} loading="eager" />
					<p>Hungry &amp; Humble</p>
				</div>
			</section>

			<section class="writing" aria-labelledby="writing-title">
				<div class="section-heading">
					<h2 id="writing-title">Recent writing</h2>
					<a class="text-link" href="/blog/">All notes <span aria-hidden="true">↗</span></a>
				</div>
				<ul class="latest-posts">
					{featuredPost && (
						<li class="featured-note">
							<a class:list={{ 'pinned-frame': featuredPost.data.pinned }} href={`/blog/${featuredPost.id}/`}>
								<div class="note-meta"><span>{categoryLabel(featuredPost.id)}</span><FormattedDate date={featuredPost.data.pubDate} /></div>
								<h3>{featuredPost.data.title}</h3>
								<p class="note-description">{featuredPost.data.description}</p>
								<span class="read-note">Read note <span aria-hidden="true">→</span></span>
							</a>
						</li>
					)}
					{remainingPosts.map((post) => (
						<li class="note-row">
							<a class:list={{ 'pinned-frame': post.data.pinned }} href={`/blog/${post.id}/`}>
								<div class="note-meta"><span>{categoryLabel(post.id)}</span><FormattedDate date={post.data.pubDate} /></div>
								<h3>{post.data.title}</h3>
								<p class="note-description">{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main.home-container { width: min(100% - 3rem, 960px); max-width: none; padding: 4rem 0 3rem; }
	.hero { display: grid; grid-template-columns: minmax(0, 1fr) 160px; align-items: center; gap: 3rem; margin-bottom: 4rem; }
	.eyebrow { margin: 0 0 1rem; color: var(--accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
	.hero h1 { margin: 0 0 1rem; font-size: clamp(2.6rem, 5vw, 4rem); font-weight: 400; letter-spacing: -0.035em; line-height: 1.1; }
	.accent-dot { color: var(--accent); }
	.hero-description { max-width: 36rem; margin: 0 0 1.25rem; color: rgb(var(--gray)); font-size: 1.1rem; line-height: 1.6; }
	.research-interests { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: 0.82rem; }
	.hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
	.button { display: inline-flex; align-items: center; gap: 0.75rem; padding: 0.65rem 1rem; border-radius: var(--radius-control); background: rgb(var(--black)); color: var(--bg); text-decoration: none; font-size: 0.85rem; }
	.button:hover { background: var(--accent-dark); color: var(--bg); }
	.text-link { color: rgb(var(--gray-dark)); text-decoration: none; font-size: 0.85rem; }
	.text-link:hover { color: var(--accent); }
	.portrait { text-align: center; }
	.portrait img { display: block; width: 160px; height: 160px; object-fit: cover; border-radius: var(--radius-card); }
	.portrait p { margin: 0.75rem 0 0; color: rgb(var(--gray)); font-size: 0.75rem; font-style: italic; }
	.section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
	.section-heading h2 { margin: 0; font-size: 1.4rem; font-weight: 400; }
	.latest-posts { margin: 0; padding: 0; list-style: none; }
	.latest-posts a { display: block; color: inherit; text-decoration: none; }
	.featured-note a { padding: 1.75rem 2rem; border: 1px solid rgb(var(--gray-light)); border-radius: var(--radius-card); background: var(--surface); }
	.featured-note a:hover { background: var(--surface-hover); }
	.note-meta { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin-bottom: 0.6rem; color: rgb(var(--gray)); font-size: 0.75rem; }
	.featured-note h3 { max-width: 42rem; margin: 0 0 0.75rem; font-size: clamp(1.35rem, 2.8vw, 1.75rem); font-weight: 500; line-height: 1.4; }
	.note-description { margin: 0; color: rgb(var(--gray)); font-size: 0.9rem; line-height: 1.7; }
	.read-note { display: inline-block; margin-top: 1.25rem; color: var(--accent); font-size: 0.82rem; font-weight: 600; }
	.note-row { border-bottom: 1px solid rgb(var(--gray-light)); }
	.note-row a { padding: 1.25rem 0.25rem; }
	.note-row h3 { margin: 0 0 0.4rem; font-size: 1.1rem; font-family: var(--font-sans); font-weight: 600; }
	.note-row a:hover h3 { color: var(--accent); }
	@media (max-width: 720px) {
		main.home-container { width: calc(100% - 2rem); padding-top: 2rem; }
		.hero { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; margin-bottom: 2.5rem; }
		.portrait { display: flex; align-items: center; gap: 0.75rem; text-align: left; }
		.portrait img { width: 56px; height: 56px; }
		.portrait p { margin: 0; }
		.hero-description { font-size: 1rem; }
		.research-interests li:last-child { flex-basis: 100%; }
		.featured-note a { padding: 1.25rem; }
	}
</style>
