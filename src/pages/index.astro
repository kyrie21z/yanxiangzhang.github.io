---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import monicaImage from '../assets/monica.png';

const allPosts = await getCollection('blog');
const latestPosts = allPosts
	.sort(
		(a, b) =>
			Number(b.data.pinned) - Number(a.data.pinned) ||
			b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	)
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* 覆盖全局 main 样式 */
			body main.home-container {
				width: 100%;
				max-width: 900px;
			}
			
			.home-container {
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 3rem;
				align-items: start;
				max-width: 900px;
				margin: 0 auto;
				padding: 2.5em 1em;
			}
			
			@media (max-width: 768px) {
				.home-container {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
			}
			
			/* 左侧信息 */
			.profile-card {
				text-align: center;
				position: sticky;
				top: 2rem;
			}
			
			.profile-image {
				width: 180px;
				height: 180px;
				border-radius: 4px;
				object-fit: cover;
				margin-bottom: 1rem;
			}
			
			.profile-name {
				font-size: 1.3rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0.25rem 0;
				font-family: var(--font-serif);
			}
			
			.profile-bio {
				font-size: 0.85rem;
				color: rgb(var(--gray));
				margin: 0.5rem 0 1rem;
				line-height: 1.5;
				font-style: italic;
			}
			
			.social-links {
				display: flex;
				justify-content: center;
				gap: 0.75rem;
			}
			
			.social-link {
				color: rgb(var(--gray));
				text-decoration: none;
				transition: color 0.2s ease;
			}
			
			.social-link:hover {
				color: var(--accent);
			}
			
			/* 右侧内容区域 */
			.content-section {
				padding: 0;
			}
			
			.section-title {
				font-size: 1.3rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.75rem;
				margin-top: 1.75rem;
				padding-bottom: 0.4rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				font-family: var(--font-serif);
			}
			
			.section-title:first-child {
				margin-top: 0;
			}
			
			.about-text {
				font-size: 0.95rem;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}
			
			.about-text p {
				margin-bottom: 0.75rem;
			}
			
			.highlight {
				font-weight: 600;
			}
			
			.research-list {
				list-style: disc;
				padding-left: 1.25rem;
				margin: 0.5rem 0;
			}
			
			.research-list li {
				font-size: 0.95rem;
				color: rgb(var(--gray-dark));
				margin: 0.25rem 0;
				line-height: 1.6;
			}

			.latest-posts {
				list-style: none;
				padding: 0;
				margin: 0.5rem 0;
			}
			.latest-posts li {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding: 0.4rem 0;
				border-bottom: 1px solid rgba(var(--gray-light), 0.5);
				font-size: 0.9rem;
			}
			.latest-posts li:last-child {
				border-bottom: none;
			}
			.latest-posts li.pinned-frame {
				margin: 0.8rem 0 0.65rem;
				padding: 0.65rem 0.75rem;
			}
			.latest-posts a {
				text-decoration: none;
				color: rgb(var(--gray-dark));
			}
			.latest-posts a:hover {
				color: var(--accent);
			}
			.latest-posts .post-date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
				white-space: nowrap;
				margin-left: 1rem;
			}
			.view-all {
				font-size: 0.9rem;
				margin-top: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-container">
			<!-- 左侧信息 -->
			<aside class="profile-card">
				<Image src={monicaImage} alt="Yanxiang Zhang" class="profile-image" width={200} height={200} />
				<h1 class="profile-name">Yanxiang Zhang</h1>
				<p class="profile-bio">Hungry & Humble</p>
				<div class="social-links">
					<a href="https://github.com/kyrie21z" class="social-link" target="_blank" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
						</svg>
					</a>
				</div>
			</aside>
			
			<!-- 右侧内容 -->
			<section class="content-section">
				<h2 class="section-title" style="margin-top: 0;">About</h2>
				<div class="about-text">
					<p>
						I am <span class="highlight">Yanxiang Zhang</span>.
						This site serves as a repository for my learning notes and technical insights, covering
						<span class="highlight">CS Major Courses</span>, <span class="highlight">Paper Sharing</span>, and
						<span class="highlight">Personal Insights</span>.
					</p>
				</div>

				<h2 class="section-title">Research Interests</h2>
				<ul class="research-list">
					<li>Computer Vision</li>
					<li>Scene Text Recognition</li>
					<li>Embodied AI</li>
				</ul>

				<h2 class="section-title">Recent Notes</h2>
				<ul class="latest-posts">
					{latestPosts.map((post) => (
						<li class:list={{ 'pinned-frame': post.data.pinned }}>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</li>
					))}
				</ul>
				<p class="view-all">
					<a href="/blog">View all notes →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
